{
 "attributes": [
  {
   "name": "semantic landmark usage",
   "definition": "Whether the page is structured with HTML5 semantic landmark elements (header, nav, main, footer, section) rather than generic containers.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "full landmark set",
     "definition": "Header, nav, main and footer are all present, along with sections."
    },
    {
     "value": "partial landmark set",
     "definition": "Some landmarks are used but one or more core ones (such as main or nav) are missing."
    },
    {
     "value": "none or other",
     "definition": "No semantic landmarks, or the statement does not say."
    }
   ]
  },
  {
   "name": "article/aside/figure usage",
   "definition": "Whether the secondary sectioning and content elements article, aside and figure are used on the page.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "article used",
     "definition": "Article elements are present."
    },
    {
     "value": "aside used",
     "definition": "Aside elements are present (without article)."
    },
    {
     "value": "absent",
     "definition": "Article, aside and/or figure are explicitly absent."
    },
    {
     "value": "not stated",
     "definition": "Not mentioned."
    }
   ]
  },
  {
   "name": "navigation and footer list markup",
   "definition": "Whether navigation and footer links are marked up as ul/li lists.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "list markup",
     "definition": "Links or content are marked up as lists."
    },
    {
     "value": "not list markup",
     "definition": "Links are not in lists."
    }
   ]
  },
  {
   "name": "uppercase tracked text treatment",
   "definition": "Whether navigation, labels or headings are set in uppercase, often bold or letter-spaced.",
   "family": "typography",
   "values": [
    {
     "value": "uppercase tracked",
     "definition": "Uppercase text with wide letter-spacing and/or bold weight."
    },
    {
     "value": "uppercase only",
     "definition": "Uppercase text without mention of tracking."
    },
    {
     "value": "mixed case",
     "definition": "Normal sentence or title case."
    }
   ]
  },
  {
   "name": "heading hierarchy and image alt text",
   "definition": "Accessibility details of headings and image alternatives.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "single h1",
     "definition": "Exactly one h1 on the page."
    },
    {
     "value": "no h1",
     "definition": "Page lacks an h1."
    },
    {
     "value": "alt text present",
     "definition": "Images have alt text."
    },
    {
     "value": "not stated",
     "definition": "Not mentioned."
    }
   ]
  }
 ],
