{
 "attributes": [
  {
   "name": "content image alt text treatment",
   "definition": "How alt attributes are used on content/photo/thumbnail images (as opposed to logos).",
   "family": "semantic_dom",
   "values": [
    {
     "value": "empty alt on content images",
     "definition": "Content, article, photo or thumbnail images have empty alt attributes."
    },
    {
     "value": "descriptive alt on content images",
     "definition": "Content images carry meaningful descriptive alt text."
    },
    {
     "value": "generic or patterned alt",
     "definition": "Alt text is generic, numbered or follows a templated pattern."
    },
    {
     "value": "mixed by role",
     "definition": "Content images get descriptive alt while decorative ones get empty alt."
    },
    {
     "value": "not specified",
     "definition": "Statement does not say how content images are treated."
    }
   ]
  },
  {
   "name": "logo alt text treatment",
   "definition": "How the logo image's alt attribute is set.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "descriptive alt",
     "definition": "Logo(s) carry descriptive alt text."
    },
    {
     "value": "empty alt",
     "definition": "Logo has an empty alt attribute, marked decorative."
    },
    {
     "value": "not specified",
     "definition": "Logo alt is not addressed."
    }
   ]
  },
  {
   "name": "alt attribute coverage",
   "definition": "Whether every image has an alt attribute present (even if empty).",
   "family": "semantic_dom",
   "values": [
    {
     "value": "all images have alt",
     "definition": "Statement asserts no image lacks an alt attribute."
    },
    {
     "value": "not stated",
     "definition": "Coverage is not asserted."
    }
   ]
  },
  {
   "name": "ARIA attribute usage",
   "definition": "Presence of ARIA attributes for accessibility alongside alt text.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "aria present",
     "definition": "ARIA attributes are used on the page."
    },
    {
     "value": "not stated",
     "definition": "ARIA is not mentioned."
    }
   ]
  }
