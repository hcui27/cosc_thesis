   "family": "decoration",
   "values": [
    {
     "value": "small radii present",
     "definition": "Some elements use small subtle radii."
    },
    {
     "value": "small radii absent",
     "definition": "Subtle small radii are avoided."
    },
    {
     "value": "not stated",
     "definition": "Not described."
    }
   ]
  },
  {
   "name": "moderate to large radius on cards/media",
