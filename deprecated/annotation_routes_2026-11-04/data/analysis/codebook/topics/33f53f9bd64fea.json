     "value": "pill buttons",
     "definition": "Buttons are pill-shaped."
    },
    {
     "value": "pills on other elements",
     "definition": "Pills or circles are used for non-button elements such as icons, dots, or tags."
    },
    {
     "value": "no pills",
     "definition": "No pill shapes are used."
    },
    {
     "value": "not stated",
     "definition": "Not described."
    }
   ]
  }
