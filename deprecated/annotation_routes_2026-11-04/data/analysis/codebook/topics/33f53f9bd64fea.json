   "values": [
    {
     "value": "moderate 8-15px",
     "definition": "Cards or images use 8-15px rounding."
    },
    {
     "value": "large 16px+",
     "definition": "Large radii of 16px or more are used."
    },
    {
     "value": "none",
     "definition": "No moderate or large radii; no large radii used."
    },
    {
     "value": "not stated",
     "definition": "Not described."
    }
   ]
  },
  {
   "name": "pill and circular shapes",
   "definition": "Presence and placement of pill-shaped or fully round elements.",
   "family": "component",
   "values": [
