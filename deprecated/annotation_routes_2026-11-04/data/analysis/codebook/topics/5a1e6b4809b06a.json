{
 "attributes": [
  {
   "name": "content container width behavior",
   "definition": "Whether the main page content is constrained to a centered container of limited width versus spanning the full viewport.",
   "family": "layout",
   "values": [
    {
     "value": "centered fixed-width container",
     "definition": "Content sits in a centered container with a fixed or max width narrower than the viewport, leaving side margins."
    },
    {
     "value": "full-width fluid",
     "definition": "Content stretches across the viewport without a constraining container."
    },
    {
     "value": "other",
     "definition": "Different or unclear arrangement."
    }
   ]
  },
  {
   "name": "full-bleed exceptions",
   "definition": "Whether selected sections (hero, colour bands, photos) break out of the centered container to span the full viewport width.",
   "family": "layout",
   "values": [
    {
     "value": "selected sections full-bleed",
     "definition": "Some bands, heroes or images run edge to edge while the rest stays in the container."
    },
    {
     "value": "none stated",
     "definition": "No full-bleed breakout sections are noted; everything stays in the container."
    }
   ]
  },
  {
   "name": "container width size",
   "definition": "Approximate maximum width of the centered content container.",
   "family": "layout",
   "values": [
    {
     "value": "narrow (about 1000-1060px or less)",
     "definition": "Container around 1000-1060px or narrower."
    },
    {
     "value": "medium (about 1080-1140px)",
     "definition": "Container roughly 1080-1140px wide."
    },
    {
     "value": "unspecified",
     "definition": "Width is not given numerically."
    }
   ]
  },
  {
   "name": "content column structure within container",
   "definition": "Internal column arrangement or alignment inside the container.",
   "family": "layout",
   "values": [
    {
     "value": "single narrow column",
     "definition": "A narrow single column of content with wide empty margins."
    },
    {
     "value": "main column plus sidebar",
     "definition": "Main content column paired with a sidebar."
    },
    {
     "value": "nested narrower columns",
     "definition": "Narrower inner text columns within the container."
    },
    {
     "value": "consistent left edge alignment",
     "definition": "Content edges align consistently, or hero text is offset to a different left edge."
    },
    {
     "value": "not specified",
     "definition": "No inner structure described."
    }
   ]
  }
 ],
