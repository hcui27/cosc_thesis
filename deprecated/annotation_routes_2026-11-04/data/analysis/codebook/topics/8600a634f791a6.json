{
 "attributes": [
  {
   "name": "header_layout_arrangement",
   "definition": "How the header's elements are distributed horizontally (logo position, nav position, utilities).",
   "family": "layout",
   "values": [
    {
     "value": "logo_only",
     "definition": "Only a logo, no nav or other elements."
    },
    {
     "value": "logo_left_nav_right",
     "definition": "Logo/wordmark at left, nav and/or actions grouped at right."
    },
    {
     "value": "three_part_split",
     "definition": "Distinct left, center and right zones (e.g. nav / logo / utilities, or logo / center nav / utilities)."
    },
    {
     "value": "single_row_inline",
     "definition": "Logo, nav, search and other items laid out sequentially in one row, not split to opposite sides."
    },
    {
     "value": "other",
     "definition": "Other arrangement."
    }
   ]
  },
  {
   "name": "header_background",
   "definition": "Background treatment of the header bar.",
   "family": "color",
   "values": [
    {
     "value": "white_light",
     "definition": "White or light background."
    },
    {
     "value": "dark",
     "definition": "Dark (navy, black, dark gray) background."
    },
    {
     "value": "unspecified",
     "definition": "Not stated."
    }
   ]
  },
  {
   "name": "header_right_side_elements",
   "definition": "What sits at the right edge of the header besides or in addition to nav links.",
   "family": "component",
   "values": [
    {
     "value": "none_or_plain_links",
     "definition": "Only plain text links or nothing."
    },
    {
     "value": "pill_or_button_cta",
     "definition": "A pill, button or CTA button (signup, phone, etc.)."
    },
    {
     "value": "icons_or_logos_or_image",
     "definition": "Social icons, secondary logo, banner image or similar graphics."
    },
    {
     "value": "search_cart_language_utility",
     "definition": "Search, cart, language box, phone number or similar utility widgets."
    },
    {
     "value": "dropdown_nav",
     "definition": "Dropdown nav items with carets/chevrons/triggers."
    }
   ]
  },
  {
   "name": "header_logo_treatment",
   "definition": "Form of the brand mark in the header.",
   "family": "component",
   "values": [
    {
     "value": "image_logo",
     "definition": "Logo image or logo mark."
    },
    {
     "value": "text_wordmark",
     "definition": "Text-only wordmark without logo image."
    },
    {
     "value": "multiple_logos",
     "definition": "Multiple logos/brand marks."
    }
   ]
  }
