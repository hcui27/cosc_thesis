{
 "attributes": [
  {
   "name": "font family count",
   "definition": "How many distinct typeface families are used across the page.",
   "family": "typography",
   "values": [
    {
     "value": "single family",
     "definition": "One font family is used for all or nearly all text."
    },
    {
     "value": "two families",
     "definition": "Two families are paired, e.g. heading and body."
    },
    {
     "value": "three or more families",
     "definition": "Three or more distinct families are used."
    },
    {
     "value": "other",
     "definition": "Not determinable or does not fit."
    }
   ]
  },
  {
   "name": "font category",
   "definition": "The classification of the typeface used for text.",
   "family": "typography",
   "values": [
    {
     "value": "sans-serif",
     "definition": "Text set in a sans-serif face (e.g. Helvetica/Arial)."
    },
    {
     "value": "system UI stack",
     "definition": "Text set in the operating system's native UI font stack."
    },
    {
     "value": "serif",
     "definition": "Text set in a serif face."
    },
    {
     "value": "mixed or other",
     "definition": "Combination of categories or something else, such as display or monospace."
    }
   ]
  },
  {
   "name": "web font loading",
   "definition": "Whether the page loads external or custom web fonts.",
   "family": "typography",
   "values": [
    {
     "value": "no web fonts",
     "definition": "Only locally available or system fonts are used; no web fonts loaded."
    },
    {
     "value": "web fonts loaded",
     "definition": "Custom or external web fonts are loaded."
    },
    {
     "value": "not stated",
     "definition": "Web font usage is not determinable."
    }
   ]
  }
