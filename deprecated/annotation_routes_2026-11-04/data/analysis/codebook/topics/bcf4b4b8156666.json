{
 "attributes": [
  {
   "name": "h1_presence_and_count",
   "definition": "Whether the page has a single H1 as the top-level heading, or lacks one.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "single_h1",
     "definition": "Exactly one H1 is present."
    },
    {
     "value": "no_h1",
     "definition": "No H1; outline starts at H2 or lower."
    },
    {
     "value": "not_stated",
     "definition": "H1 presence not addressed."
    }
   ]
  },
  {
   "name": "heading_level_ordering",
   "definition": "Whether heading levels follow a logical, sequential order without skipping levels or appearing out of order.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "orderly",
     "definition": "Levels are sequential and in logical order, no skips."
    },
    {
     "value": "skips_levels",
     "definition": "Levels are skipped (e.g., H2 to H4, H1 to H4) or deeper headings precede their parents."
    },
    {
     "value": "out_of_dom_order",
     "definition": "Headings appear in DOM order that mismatches the visual or logical order (e.g., sidebar before main)."
    }
   ]
  },
  {
   "name": "heading_depth",
   "definition": "How many distinct heading levels the page uses.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "shallow",
     "definition": "Only one or two levels beyond H1, or very few headings overall."
    },
    {
     "value": "standard",
     "definition": "Three levels (H1-H3) used in a typical hierarchy."
    },
    {
     "value": "deep",
     "definition": "Four or more levels used, including H4/H5."
    }
   ]
  },
  {
   "name": "footer_heading_level",
   "definition": "Which heading level is used for footer column titles.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "h2",
     "definition": "Footer titles are H2."
    },
    {
     "value": "h3",
     "definition": "Footer titles are H3."
    },
    {
     "value": "h4",
     "definition": "Footer titles are H4."
    },
    {
     "value": "not_stated",
     "definition": "Footer headings not addressed."
    }
   ]
  }
 ],
