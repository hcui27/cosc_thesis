     "definition": "Rule above a single copyright/legal line."
    },
    {
     "value": "centered copyright text",
     "definition": "Small centered copyright with no divider."
    },
    {
     "value": "not distinct",
     "definition": "No separate bottom bar described."
    }
   ]
  },
