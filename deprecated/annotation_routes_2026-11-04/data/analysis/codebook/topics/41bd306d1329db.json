    },
    {
     "value": "minimal centered",
     "definition": "Single centered or very sparse content."
    },
    {
     "value": "minimal row",
     "definition": "Only a thin row of legal or links, no column grid."
    }
   ]
  },
  {
   "name": "footer bottom bar",
