  {
   "name": "section column structure",
   "definition": "How a content section divides its horizontal space into columns.",
   "family": "layout",
   "values": [
    {
     "value": "two equal-column split",
     "definition": "Section split into two roughly equal columns (text/media, text/list, text/chips, or heading/cards)."
    },
    {
     "value": "main plus narrow sidebar",
     "definition": "Wide primary column with a narrower secondary sidebar."
    },
    {
     "value": "centered single column",
     "definition": "Section content stacked and centered in a single column."
    },
    {
     "value": "other",
     "definition": "Any other arrangement."
    }
   ]
  },
  {
   "name": "split row image placement",
   "definition": "Whether image/text split rows keep media on a fixed side or alternate sides down the page.",
   "family": "layout",
   "values": [
    {
     "value": "alternating sides",
     "definition": "Image side switches from row to row."
    },
    {
     "value": "fixed side",
     "definition": "Image stays on the same side in a split section."
    },
    {
     "value": "no image in split",
     "definition": "The split does not involve an image."
    }
   ]
  },
  {
   "name": "secondary column content type",
   "definition": "What fills the non-intro/companion column of a split section.",
   "family": "component",
   "values": [
    {
     "value": "image",
     "definition": "A photo or illustration."
    },
    {
     "value": "ruled list of rows",
     "definition": "Hairline-divided list of rows, possibly with arrows."
    },
    {
     "value": "pill chips",
     "definition": "Cloud or row of pill-shaped chips/tags."
    },
    {
     "value": "card grid",
     "definition": "Grid of cards."
    },
    {
     "value": "parallel content modules",
     "definition": "Independent feed/event style blocks side by side."
    },
    {
     "value": "main content or sidebar",
     "definition": "Primary content with a sidebar."
    },
    {
     "value": "other",
     "definition": "Something else."
    }
   ]
  }
