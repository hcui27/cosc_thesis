{
 "attributes": [
  {
   "name": "DOM size and leanness",
   "definition": "Overall weight of the markup, i.e. how few elements, divs and classes the page uses.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "lean",
     "definition": "Markup is described as small, minimal or lightweight with few elements."
    },
    {
     "value": "not lean",
     "definition": "Markup is heavy or deeply nested."
    },
    {
     "value": "not stated",
     "definition": "No claim about DOM weight."
    }
   ]
  },
  {
   "name": "CSS delivery method",
   "definition": "How styles are delivered to the page.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "single inline style block",
     "definition": "All styling in one embedded style element, with no external stylesheet."
    },
    {
     "value": "single external stylesheet",
     "definition": "One linked stylesheet file."
    },
    {
     "value": "no stylesheet mentioned",
     "definition": "Statement says no external stylesheets or doesn't address CSS delivery beyond that."
    },
    {
     "value": "inline style attributes",
     "definition": "Styles applied mostly via style attributes."
    }
   ]
  },
  {
   "name": "Script usage",
   "definition": "Amount of JavaScript included on the page.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "none",
     "definition": "No scripts."
    },
    {
     "value": "single or minimal",
     "definition": "One script or very few scripts."
    },
    {
     "value": "heavy",
     "definition": "Many scripts."
    },
    {
     "value": "not stated",
     "definition": "No claim about scripts."
    }
   ]
  },
  {
   "name": "Semantic landmark elements",
   "definition": "Use of semantic HTML elements such as section, article, footer.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "used",
     "definition": "Semantic elements are explicitly used."
    },
    {
     "value": "not stated",
     "definition": "Not mentioned."
    }
   ]
  }
