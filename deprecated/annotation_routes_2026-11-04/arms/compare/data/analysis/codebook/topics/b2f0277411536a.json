{
 "attributes": [
  {
   "name": "semantic landmark usage",
   "definition": "Whether the page uses HTML5 semantic landmark/sectioning elements (main, section, article, nav, aside, etc.) rather than generic divs.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "rich landmarks",
     "definition": "Uses several landmark/sectioning elements beyond header/nav/footer (main, section, article, aside, figure, dialog)."
    },
    {
     "value": "basic landmarks",
     "definition": "Uses a limited set of landmarks such as nav, section, or main only."
    },
    {
     "value": "generic only",
     "definition": "Relies on generic div/table structure."
    },
    {
     "value": "not stated",
     "definition": "Not mentioned."
    }
   ]
  },
  {
   "name": "heading hierarchy structure",
   "definition": "How headings are nested and leveled in the page outline.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "clean h1-h2-h3",
     "definition": "Clean, orderly hierarchy with h1 (or implied) then h2 sections and h3 items."
    },
    {
     "value": "deep hierarchy",
     "definition": "Hierarchy extends to h4 or beyond (e.g. footer columns, card titles as h4)."
    },
    {
     "value": "irregular",
     "definition": "Skips levels, missing h1, or starts at a lower level."
    },
    {
     "value": "not stated",
     "definition": "Not mentioned."
    }
   ]
  },
  {
   "name": "section heading alignment",
   "definition": "Horizontal alignment of section headings.",
   "family": "layout",
   "values": [
    {
     "value": "centered",
     "definition": "Section headings centered."
    },
    {
     "value": "left-aligned",
     "definition": "Section headings left-aligned."
    },
    {
     "value": "split with side element",
     "definition": "Heading at left with a right-aligned subtitle or link on the same row."
    },
    {
     "value": "not stated",
     "definition": "Not mentioned."
    }
   ]
  },
  {
   "name": "section heading decoration",
   "definition": "Underline, rule or accent treatment on section headings.",
   "family": "decoration",
   "values": [
    {
     "value": "short accent bar",
     "definition": "Short colored underline bar beneath heading."
    },
    {
     "value": "heavy full rule",
     "definition": "Heavy full-width underline rule."
    },
    {
     "value": "none",
     "definition": "No decoration."
    }
   ]
  }
 ],
