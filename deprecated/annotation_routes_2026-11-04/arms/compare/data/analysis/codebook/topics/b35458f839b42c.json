  {
   "name": "title_structure",
   "definition": "How the page title/document title is composed: brand alone, brand plus tagline/descriptor, brand plus product list, or a descriptive sentence.",
   "family": "copy",
   "values": [
    {
     "value": "brand_only",
     "definition": "Short title containing just the brand name, no tagline or keywords."
    },
    {
     "value": "brand_plus_tagline",
     "definition": "Brand name combined with a short tagline or descriptive phrase."
    },
    {
     "value": "brand_plus_full_name",
     "definition": "Brand name followed by its expanded/full organisation name."
    },
    {
     "value": "brand_plus_product_list",
     "definition": "Brand name followed by a list of products or services."
    },
    {
     "value": "brand_plus_parent_brand",
     "definition": "Page title ending with a parent brand name."
    },
    {
     "value": "descriptive_sentence",
     "definition": "Title is a sentence describing what the site offers and for whom."
    }
   ]
  },
