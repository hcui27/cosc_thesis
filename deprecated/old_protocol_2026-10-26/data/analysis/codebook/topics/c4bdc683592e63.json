{
 "attributes": [
  {
   "name": "external_stylesheet_usage",
   "definition": "Whether the page loads CSS from external stylesheet files or keeps styling self-contained (inline style block).",
   "family": "semantic_dom",
   "values": [
    {
     "value": "self_contained_inline_css",
     "definition": "Page uses an inline style block (or inline styling) and explicitly no external stylesheets."
    },
    {
     "value": "external_stylesheets",
     "definition": "Page links to one or more external stylesheets."
    },
    {
     "value": "not_stated",
     "definition": "Not addressed."
    }
   ]
  },
  {
   "name": "script_count",
   "definition": "Amount of JavaScript included on the page.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "none",
     "definition": "No scripts at all."
    },
    {
     "value": "single_script",
     "definition": "Exactly one script."
    },
    {
     "value": "few_scripts",
     "definition": "A small number of scripts, described as few or minimal."
    },
    {
     "value": "many_scripts",
     "definition": "Numerous scripts."
    }
   ]
  },
  {
   "name": "dom_node_and_wrapper_density",
   "definition": "How compact the DOM is in terms of div wrappers, nesting and overall node count.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "lean_few_divs",
     "definition": "Few divs/nodes, shallow, flat structure."
    },
    {
     "value": "heavy_nested",
     "definition": "Many divs, deep nesting."
    },
    {
     "value": "not_stated",
     "definition": "Not addressed."
    }
   ]
  },
  {
   "name": "class_vocabulary_size",
   "definition": "Size and nature of the CSS class vocabulary used in markup.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "few_handwritten_classes",
     "definition": "Few unique, semantic or hand-authored classes, no utility framework."
    },
    {
     "value": "large_or_utility_classes",
     "definition": "Many classes or utility-framework classes."
    },
    {
     "value": "not_stated",
     "definition": "Not addressed."
    }
   ]
  },
  {
   "name": "inline_style_attribute_usage",
   "definition": "Extent of inline style=\"\" attributes on elements.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "none_or_minimal",
     "definition": "No or very few inline style attributes."
    },
    {
     "value": "heavy_inline",
     "definition": "Extensive inline style attributes."
    },
    {
     "value": "not_stated",
     "definition": "Not addressed."
    }
   ]
  },
  {
   "name": "aria_and_metadata_footprint",
   "definition": "Amount of ARIA attributes, meta tags and structured data in the document.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "minimal",
     "definition": "Few ARIA attributes, meta tags, or structured-data blocks; relies on native semantics."
    },
    {
     "value": "extensive",
     "definition": "Rich ARIA, meta tags or structured data."
    },
    {
     "value": "not_stated",
     "definition": "Not addressed."
    }
   ]
  },
  {
   "name": "semantic_landmark_structure",
   "definition": "Use of semantic HTML elements (landmarks, sections, native controls).",
   "family": "semantic_dom",
   "values": [
    {
     "value": "minimal_native_semantics",
     "definition": "Uses native semantic elements sparingly and simply (single main/header/nav/footer, real buttons, sections not articles)."
    },
    {
     "value": "rich_semantics",
     "definition": "Extensive use of article, aside and other wrappers."
    },
    {
     "value": "not_stated",
     "definition": "Not addressed."
    }
   ]
  }
 ],
