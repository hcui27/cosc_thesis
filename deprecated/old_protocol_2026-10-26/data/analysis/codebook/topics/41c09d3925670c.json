{
 "attributes": [
  {
   "name": "heading hierarchy cleanliness",
   "definition": "Whether the page's heading levels form a properly nested, sequential outline (e.g. h1 then h2 then h3) without skipped or misused levels.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "clean nested hierarchy",
     "definition": "Headings are described as orderly, sequential, proper or nested, with levels used consistently."
    },
    {
     "value": "deep or varied outline",
     "definition": "A deep or rich outline using many heading levels (h2/h3/h4) widely, without emphasis on strict sequencing."
    },
    {
     "value": "flat or broken hierarchy",
     "definition": "Headings are mostly one level, skipped, or misordered."
    },
    {
     "value": "not stated",
     "definition": "No assertion about overall heading hierarchy."
    }
   ]
  },
  {
   "name": "card and item title heading level",
   "definition": "The heading level used for titles of cards, products, posts or sub-items within a section.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "h3",
     "definition": "Card, product, item or post titles are h3 headings."
    },
    {
     "value": "h4",
     "definition": "Sub-group or item titles are h4 headings."
    },
    {
     "value": "h2",
     "definition": "Card or item titles are h2 headings."
    },
    {
     "value": "not stated",
     "definition": "No assertion about item title level."
    }
   ]
  },
  {
   "name": "section title heading level",
   "definition": "The heading level used for main section titles on the page.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "h2",
     "definition": "Section titles are h2 headings."
    },
    {
     "value": "h1",
     "definition": "Section titles use h1."
    },
    {
     "value": "other level",
     "definition": "Section titles use another level such as h3."
    },
    {
     "value": "not stated",
     "definition": "No assertion about section title level."
    }
   ]
  },
  {
   "name": "footer column heading level",
   "definition": "The heading level used for footer column titles or labels.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "h3",
     "definition": "Footer column titles are h3."
    },
    {
     "value": "h4",
     "definition": "Footer column titles are h4."
    },
    {
     "value": "not stated",
     "definition": "No assertion about footer column heading level."
    }
   ]
  },
  {
   "name": "semantic landmark elements",
   "definition": "Whether the page uses semantic HTML landmark/sectioning elements (header, nav, main, section, aside, footer, article).",
   "family": "semantic_dom",
   "values": [
    {
     "value": "multiple landmarks used",
     "definition": "Several semantic landmark or sectioning elements are used."
    },
    {
     "value": "minimal landmarks",
     "definition": "Only one or very few landmark elements are used."
    },
    {
     "value": "not stated",
     "definition": "No assertion about landmark elements."
    }
   ]
  },
  {
   "name": "h1 uniqueness",
   "definition": "Whether the page has a single h1.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "single h1",
     "definition": "Exactly one h1 on the page."
    },
    {
     "value": "multiple or missing h1",
     "definition": "More than one h1 or none."
    },
    {
     "value": "not stated",
     "definition": "No assertion about the h1 count."
    }
   ]
  }
 ],
