{
 "attributes": [
  {
   "name": "content container width",
   "definition": "Whether page content is constrained to a bounded-width container (with side margins) rather than spanning the full viewport width.",
   "family": "layout",
   "values": [
    {
     "value": "constrained container",
     "definition": "Content is held in a max-width or fixed-width container with visible side margins/gutters."
    },
    {
     "value": "full width",
     "definition": "Content runs near the full viewport width."
    },
    {
     "value": "not stated",
     "definition": "Container width is not specified."
    }
   ]
  },
  {
   "name": "content horizontal alignment",
   "definition": "How the content container or column is positioned horizontally on the page.",
   "family": "layout",
   "values": [
    {
     "value": "centered container",
     "definition": "The content container/column is centered horizontally in the viewport."
    },
    {
     "value": "left-aligned",
     "definition": "Content is aligned to the left rather than centered."
    },
    {
     "value": "not stated",
     "definition": "Horizontal positioning is not specified."
    }
   ]
  },
  {
   "name": "left edge consistency",
   "definition": "Whether content across sections and headings shares a common left edge.",
   "family": "layout",
   "values": [
    {
     "value": "consistent shared left edge",
     "definition": "Sections, headings and text align to one common left edge."
    },
    {
     "value": "not stated",
     "definition": "Edge alignment is not specified."
    }
   ]
  },
  {
   "name": "side margin generosity",
   "definition": "How much horizontal whitespace (gutters/margins) surrounds the content container.",
   "family": "layout",
   "values": [
    {
     "value": "generous side margins",
     "definition": "Wide gutters or margins around a narrow content column."
    },
    {
     "value": "standard gutters",
     "definition": "Ordinary or consistent side gutters without emphasis on width."
    },
    {
     "value": "not stated",
     "definition": "Side margins are not specified."
    }
   ]
  }
 ],
