{
 "attributes": [
  {
   "name": "section_separation_method",
   "definition": "The primary mechanism used to visually separate consecutive page sections.",
   "family": "layout",
   "values": [
    {
     "value": "alternating_background_bands",
     "definition": "Sections are separated by full-width bands whose background colors alternate."
    },
    {
     "value": "single_accent_band",
     "definition": "A single section is set off by a distinct background band against otherwise uniform white areas."
    },
    {
     "value": "rules_dividers",
     "definition": "Horizontal rules or hairlines separate sections."
    },
    {
     "value": "other_or_none",
     "definition": "Some other method or no explicit separation."
    }
   ]
  },
  {
   "name": "band_color_palette",
   "definition": "The character of colors used for alternating section background bands.",
   "family": "color",
   "values": [
    {
     "value": "light_neutral_warm",
     "definition": "Cream, beige, off-white, peach or warm pale tints alternating with white."
    },
    {
     "value": "light_cool_tint",
     "definition": "Pale blue-gray, mint, sage, or light grey tints alternating with white."
    },
    {
     "value": "light_and_dark_mix",
     "definition": "Light bands alternate with dark (navy, teal, near-black, slate) bands."
    },
    {
     "value": "dark_tonal_only",
     "definition": "All bands are dark, varying between shades of the same dark hue."
    },
    {
     "value": "saturated_color_bands",
     "definition": "Bold mid-tone or solid color bands such as navy, off-white and mid-blue."
    },
    {
     "value": "not_applicable",
     "definition": "No color banding described."
    }
   ]
  },
  {
   "name": "band_container_treatment",
   "definition": "Whether section bands are full-bleed or wrapped in boxes.",
   "family": "layout",
   "values": [
    {
     "value": "full_width_bands",
     "definition": "Sections span the full viewport width as bands without boxed wrappers."
    },
    {
     "value": "boxed_wrappers",
     "definition": "Sections sit inside boxed or shadowed containers."
    },
    {
     "value": "unspecified",
     "definition": "Not stated."
    }
   ]
  }
 ],
