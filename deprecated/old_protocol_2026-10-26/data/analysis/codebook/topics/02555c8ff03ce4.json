{
 "attributes": [
  {
   "name": "semantic landmark usage",
   "definition": "Whether the page structures content with HTML5 semantic landmark/sectioning elements rather than generic containers.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "broad landmark set",
     "definition": "Uses several different landmark/semantic elements (e.g. header, nav, main, section, footer, aside) to structure the page."
    },
    {
     "value": "main landmark only",
     "definition": "Content is wrapped in a main landmark, with no other landmarks emphasized."
    },
    {
     "value": "generic containers",
     "definition": "Relies mainly on generic div/span wrappers rather than semantic landmarks."
    },
    {
     "value": "other",
     "definition": "Other approach to landmark usage."
    }
   ]
  },
  {
   "name": "content-level semantic elements",
   "definition": "Use of semantic elements for content items and details beyond page-level landmarks (article, figure, blockquote, time, address, button, ARIA).",
   "family": "semantic_dom",
   "values": [
    {
     "value": "rich semantic content elements",
     "definition": "Uses semantic elements or ARIA for content pieces such as article, figure, blockquote, time, address, real buttons."
    },
    {
     "value": "not present",
     "definition": "No notable content-level semantic elements mentioned."
    }
   ]
  },
  {
   "name": "DOM minimalism",
   "definition": "How lean the DOM is in terms of wrappers, scripts and inline styles.",
   "family": "semantic_dom",
   "values": [
    {
     "value": "minimal DOM",
     "definition": "Few wrappers, scripts and inline styles."
    },
    {
     "value": "not specified",
     "definition": "No claim about DOM leanness."
    }
   ]
  }
 ],
